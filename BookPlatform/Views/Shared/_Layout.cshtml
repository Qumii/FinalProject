@using Microsoft.AspNetCore.Identity
@using BookPlatform.Models
@using BookPlatform.Areas.AdminPanel

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Rəf</title>
    <link rel="icon" type="image/webp" href="https://images.vexels.com/media/users/3/229082/isolated/preview/6fabc24c3830d75486725cc6d786dfbb-book-circles-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Source+Serif+4:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="top">
        <div class="top-inner">
            <a class="brand" asp-controller="Home" asp-action="Index"><img src="https://images.vexels.com/media/users/3/229082/isolated/preview/6fabc24c3830d75486725cc6d786dfbb-book-circles-logo.png" alt="Alternate Text" style="width:50px; height:50px;" />Rəf</a>
            <nav class="top-links">
                <a asp-controller="Books" asp-action="Index">Kataloq</a>
                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-controller="Shelf" asp-action="Index">Rəfim</a>
                    <a asp-controller="Books" asp-action="Recommendations">Tövsiyələr</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="AdminPanel" asp-controller="Admin" asp-action="Index">Admin panel</a>
                }
            </nav>
            <div class="auth-area">
                @if (SignInManager.IsSignedIn(User))
                {
                    <span class="who">Salam, @(UserManager.GetUserName(User))</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="link-btn">Çıxış</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="link-btn">Giriş</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-outline">Qeydiyyat</a>
                }
            </div>
        </div>
    </header>

    <div class="wrap page-body">
        @if (TempData["Message"] != null)
        {
            <div class="flash">@TempData["Message"]</div>
        }
        @RenderBody()
    </div>

    <footer>
        <div class="wrap">
            <span>Rəf — Kitab rəyi və tövsiyə platforması</span>
            <span>2026 - Müəllif hüquqları qorunur.</span>
        </div>
    </footer>

    <div class="toast" id="toast"></div>

    <form id="globalAntiForgeryForm" style="display:none">
        @Html.AntiForgeryToken()
    </form>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
