@using BookPlatform.ViewModels.Account


@model LoginVM
@{
    ViewData["Title"] = "Giriş";
}
<div class="form-card">
    <h1>Giriş</h1>
    <div class="sub">Hesabına daxil ol</div>

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <div class="form-group">
            <label asp-for="Email">E-poçt</label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password">Şifrə</label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password"></span>
        </div>
        <div class="form-check">
            <input asp-for="RememberMe" type="checkbox" style="width:auto" />
            <label asp-for="RememberMe" style="margin:0; text-transform:none; font-size:12.5px;">Məni yadda saxla</label>
        </div>
        <button type="submit" class="btn btn-brass" style="width:100%;">Daxil ol</button>
    </form>

    <div class="form-foot">Hesabın yoxdur? <a asp-action="Register">Qeydiyyatdan keç</a></div>

</div>

