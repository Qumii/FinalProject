@model IEnumerable<BookReview.Models.UserShelf>

@{
    var hasItems = Model != null && Model.Any();
}

@if (hasItems)
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model!)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                    <img src="@(string.IsNullOrEmpty(item.Book?.CoverImageUrl) ? "https://via.placeholder.com/300x400" : item.Book.CoverImageUrl)"
                         class="card-img-top" style="height: 240px; object-fit: cover;" alt="@item.Book?.Title" />

                    <div class="card-body d-flex flex-column p-3">
                        <h6 class="fw-bold text-truncate mb-1">@item.Book?.Title</h6>
                        <small class="text-muted mb-3">
                            <i class="fa-solid fa-pen-nib me-1"></i>@(item.Book?.Author?.Name ?? "Naməlum müəllif")
                        </small>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-dark">
                                Ətraflı
                            </a>

                            <form asp-controller="UserShelf" asp-action="Remove" method="post" onsubmit="return confirm('Rəfdən silinsin?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Rəfdən Sil">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5 bg-white rounded-3 border">
        <i class="fa-solid fa-folder-open text-muted mb-2" style="font-size: 2.5rem;"></i>
        <p class="text-muted m-0">Bu kateqoriyada hələ kitab yoxdur.</p>
    </div>
}