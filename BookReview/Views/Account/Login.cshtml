@model BookReview.ViewModels.Account.LoginVM

@{
    ViewData["Title"] = "Daxil Ol";
}

<div class="row justify-content-center py-5">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <h3 class="fw-bold text-center mb-4"><i class="fa-solid fa-right-to-bracket text-warning me-2"></i>Daxil Ol</h3>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label font-semibold">Email Ünvanı</label>
                        <input asp-for="Email" class="form-control" placeholder="nümunə@mail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-semibold">Şifrə</label>
                        <input asp-for="Password" class="form-control" placeholder="******" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 fw-bold py-2 mt-2">Daxil Ol</button>
                </form>

                <hr class="my-4" />
                <p class="text-center text-muted m-0 small">
                    Hesabınız yoxdur? <a asp-action="Register" class="text-warning fw-bold text-decoration-none">Qeydiyyatdan keçin</a>
                </p>
            </div>
        </div>
    </div>
</div>