<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookVerse</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome İkonları -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
            color: #212529;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .main-container {
            flex: 1;
        }

        .footer {
            background-color: #0f172a;
            color: #94a3b8;
        }

        .card-img-top {
            height: 260px;
            object-fit: cover;
        }
    </style>
</head>
<body>
    <!-- Naviqasiya Paneli (Navbar) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand text-warning" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-book-open-reader me-2"></i>BookVerse
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i> Ana Səhifə</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Books" asp-action="Index"><i class="fa-solid fa-books me-1"></i> Kitablar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="UserShelf" asp-action="Index"><i class="fa-solid fa-bookmark me-1"></i> Şəxsi Rəf</a>
                    </li>
                </ul>

                <!-- Axtarış Qutusu -->
                <form class="d-flex me-3" asp-controller="Books" asp-action="Index" method="get">
                    <div class="input-group input-group-sm">
                        <input class="form-control" type="search" name="searchQuery" placeholder="Kitab və ya müəllif axtar..." aria-label="Axtar">
                        <button class="btn btn-warning" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                    </div>
                </form>

                <!-- İstifadəçi, Admin və Auth Menyusu -->
                <ul class="navbar-nav align-items-center">

                    @if (User.IsInRole("Admin"))
                    {
                        <!-- Yalnız Adminlər üçün görünən menyu -->
                        <li class="nav-item dropdown me-2">
                            <a class="nav-link dropdown-toggle text-warning" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-user-gear me-1"></i> Admin Panel
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li><a class="dropdown-item" asp-controller="AdminBook" asp-action="Index"><i class="fa-solid fa-list me-2"></i>Kitabları İdarə Et</a></li>
                                <li><a class="dropdown-item" asp-controller="AdminBook" asp-action="Create"><i class="fa-solid fa-plus me-2"></i>Yeni Kitab Əlavə Et</a></li>
                            </ul>
                        </li>
                    }

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- Daxil olunubsa: İstifadəçi Adı və Çıxış Et düyməsi -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-light fw-semibold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-circle-user text-warning me-1"></i> @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <a class="dropdown-item" asp-controller="UserShelf" asp-action="Index">
                                        <i class="fa-solid fa-bookmark me-2"></i>Şəxsi Rəfim
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                        <i class="fa-solid fa-right-from-bracket me-2"></i>Çıxış Et
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <!-- Daxil olunmayıbsa: Login və Register düymələri -->
                        <li class="nav-item me-1">
                            <a class="btn btn-outline-light btn-sm px-3" asp-controller="Account" asp-action="Login">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Daxil Ol
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-warning btn-sm px-3 fw-semibold" asp-controller="Account" asp-action="Register">
                                <i class="fa-solid fa-user-plus me-1"></i> Qeydiyyat
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    <!-- Əsas Məzmun Hissəsi -->
    <main class="main-container py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer py-4 mt-auto">
        <div class="container text-center">
            <p class="mb-1">&copy; 2026 BookVerse — Kitab İcmalı və Tövsiyə Platforması</p>
            <small class="text-muted">Müəllif hüquqları qorunur.</small>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>