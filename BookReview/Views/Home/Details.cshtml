@model BookReview.Models.Book

@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <a asp-action="Index" class="btn btn-outline-secondary mb-4">
        <i class="fa-solid fa-arrow-left me-1"></i> Kataloqa Qayıt
    </a>

    <!-- Kitab Haqqında Kart -->
    <div class="card border-0 shadow-lg p-4 rounded-4 mb-5">
        <div class="row g-4 align-items-center">
            <div class="col-md-4 text-center">
                <img src="@Model.CoverImageUrl" class="img-fluid rounded-3 shadow" style="max-height: 400px; object-fit: cover;" alt="@Model.Title">
            </div>
            <div class="col-md-8">
                <span class="badge bg-warning text-dark px-3 py-2 mb-2 fw-semibold">@(Model.Genre?.Name ?? "Klassika")</span>
                <h1 class="fw-bold mb-2">@Model.Title</h1>
                <p class="text-muted fs-5 mb-3">
                    <i class="fa-solid fa-pen-nib me-2"></i> Müəllif: <strong>@(Model.Author?.Name ?? "Naməlum Müəllif")</strong>
                </p>
                <hr />
                <h5 class="fw-bold">Haqqında:</h5>
                <p class="text-secondary leading-relaxed">@Model.Description</p>
            </div>
        </div>
    </div>

    <!-- RƏY BÖLMƏSİ -->
    <div id="reviewSection" class="mt-4">
        <h3 class="fw-bold mb-4"><i class="fa-solid fa-comments text-primary me-2"></i>Oxucu Rəyləri</h3>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Rəy Yazma Forması -->
        <div class="card border-0 shadow-sm p-4 mb-4 bg-light rounded-3">
            <h5 class="fw-bold mb-3">Rəy Bildirin</h5>
            <form asp-action="AddReview" method="post">
                <!-- Sizin Review modelinizə uyğun sahələr -->
                <input type="hidden" name="BookId" value="@Model.Id" />

                <div class="row g-3">
                    <div class="col-md-12 mb-2">
                        <label class="form-label fw-bold">Qiymətləndirmə (Ulduz):</label>
                        <select name="Rating" class="form-select">
                            <option value="5">⭐⭐⭐⭐⭐ (5 - Mükəmməl)</option>
                            <option value="4">⭐⭐⭐⭐ (4 - Yaxşı)</option>
                            <option value="3">⭐⭐⭐ (3 - Orta)</option>
                            <option value="2">⭐⭐ (2 - Zəif)</option>
                            <option value="1">⭐ (1 - Pis)</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <textarea name="Comment" class="form-control" rows="3" placeholder="Kitab haqqında təəssüratlarınızı yazın..." required></textarea>
                    </div>
                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-warning fw-semibold px-4">Rəyi Göndər</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
