@model IEnumerable<BookReview.Models.ShelfItem>

@{
    ViewData["Title"] = "Mənim Rəfim";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa-solid fa-bookmark text-warning me-2"></i>Mənim Oxu Rəfim</h2>
        <a asp-action="Index" class="btn btn-outline-primary">
            <i class="fa-solid fa-plus me-1"></i> Yeni Kitab Əlavə Et
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 shadow-sm rounded-4 bg-light">
            <i class="fa-solid fa-book-open display-1 text-muted mb-3"></i>
            <h4 class="text-secondary fw-semibold">Rəfinizdə hələ ki kitab yoxdur.</h4>
            <p class="text-muted">Kataloqdan bəyəndiyiniz kitabları rəfə əlavə edərək oxu siyahınızı yarada bilərsiniz.</p>
            <a asp-action="Index" class="btn btn-warning fw-bold px-4 mt-2">Kataloqa Keç</a>
        </div>
    }
    else
    {
        <!-- Tab-lar (Kateqoriya Filtri) -->
        <ul class="nav nav-pills mb-4 gap-2" id="shelfTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-item btn btn-outline-dark active px-4" id="all-tab" data-bs-toggle="tab" data-bs-target="#all">Hamısı (@Model.Count())</button>
            </li>
            <li class="nav-item">
                <button class="nav-item btn btn-outline-warning px-4" id="readlater-tab" data-bs-toggle="tab" data-bs-target="#readlater">Oxuyacaqlarım (@Model.Count(x => x.ShelfType == "ReadLater"))</button>
            </li>
            <li class="nav-item">
                <button class="nav-item btn btn-outline-info px-4" id="reading-tab" data-bs-toggle="tab" data-bs-target="#reading">Oxuduqlarım (@Model.Count(x => x.ShelfType == "Reading"))</button>
            </li>
            <li class="nav-item">
                <button class="nav-item btn btn-outline-success px-4" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed">Bitirdiklərim (@Model.Count(x => x.ShelfType == "Completed"))</button>
            </li>
        </ul>

        <!-- Kitab Kartları -->
        <div class="tab-content">
            <div class="tab-pane fade show active" id="all">
                <div class="row g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-3">
                            <div class="card h-100 shadow-sm border-0 rounded-3">
                                <img src="@item.CoverUrl" class="card-img-top p-2" style="height:240px; object-fit: contain;" alt="@item.Title">
                                <div class="card-body d-flex flex-column">
                                    <h6 class="fw-bold mb-1 text-truncate">@item.Title</h6>
                                    <p class="text-muted small mb-2">@item.Author</p>

                                    <span class="badge mb-3 @(item.ShelfType == "Completed" ? "bg-success" : item.ShelfType == "Reading" ? "bg-info" : "bg-warning text-dark")">
                                        @(item.ShelfType == "Completed" ? "Bitirildi" : item.ShelfType == "Reading" ? "Oxunur" : "Oxunacaq")
                                    </span>

                                    <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-primary mt-auto">
                                        Ətraflı
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>