@model IEnumerable<BookReview.Models.Book>

@if (ViewBag.ApiDebug != null)
{
    <div class="alert alert-danger my-3">
        <strong>XƏTA BAŞ VERDİ:</strong> @ViewBag.ApiDebug
    </div>
}

@if (TempData["ShelfMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show my-3" role="alert">
        <i class="fa-solid fa-check-circle me-1"></i> @TempData["ShelfMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{
    ViewData["Title"] = "Kitab Kataloqu";
}

<div class="container my-4">
    <h2 class="fw-bold mb-4">📚 Kitab Kataloqu</h2>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-3">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        <img src="@item.CoverImageUrl" class="card-img-top p-2" style="height:260px; object-fit: contain;" alt="@item.Title">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-truncate" title="@item.Title">@item.Title</h5>
                            <p class="text-muted small mb-2">
                                <i class="fa-solid fa-user me-1"></i> Müəllif: @(item.Author?.Name ?? "Bilinmir")
                            </p>
                            <p class="card-text small text-secondary flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Description
                            </p>

                            <!-- 1. ƏTRAFLI OXU DÜYMƏSİ -->
                            <a asp-controller="Home"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               asp-route-title="@item.Title"
                               asp-route-author="@item.Author?.Name"
                               asp-route-coverUrl="@item.CoverImageUrl"
                               asp-route-description="@item.Description"
                               class="btn btn-outline-primary btn-sm rounded-2 w-100 mt-2">
                                <i class="fa-solid fa-eye me-1"></i> Ətraflı Oxu
                            </a>

                            <!-- 3. RƏFƏ ƏLAVƏ ET DÜYMƏSİ VƏ DROPDOWN -->
                            <form asp-controller="Home" asp-action="AddToShelf" method="post" class="mt-2">
                                <input type="hidden" name="bookId" value="@item.Id" />
                                <div class="input-group">
                                    <select name="shelfType" class="form-select form-select-sm">
                                        <option value="ReadLater">Oxuyacaqlarım</option>
                                        <option value="Reading">Hal-hazırda Oxuduqlarım</option>
                                        <option value="Completed">Oxuyub Bitirdiklərim</option>
                                    </select>
                                    <button type="submit" class="btn btn-warning btn-sm fw-bold">+</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-warning">
                Sistemdə göstəriləcək kitab tapılmadı. (Model boşdur)
            </div>
        }
    </div>
</div>